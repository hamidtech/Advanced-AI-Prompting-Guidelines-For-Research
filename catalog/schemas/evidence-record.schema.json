{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "identifier": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "accessed": {
          "type": "string",
          "format": "date"
        },
        "access_level": {
          "enum": [
            "full_text",
            "abstract",
            "metadata",
            "excerpt"
          ]
        }
      },
      "required": [
        "id",
        "title",
        "identifier",
        "url",
        "accessed",
        "access_level"
      ],
      "additionalProperties": false
    },
    "fields": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "properties": {
          "status": {
            "enum": [
              "reported",
              "missing",
              "ambiguous",
              "ai_inference"
            ]
          },
          "value": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          },
          "source_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "page": {
            "type": [
              "string",
              "null"
            ]
          },
          "section": {
            "type": [
              "string",
              "null"
            ]
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "value",
          "source_id",
          "page",
          "section",
          "note"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "missing"
                }
              }
            },
            "then": {
              "properties": {
                "value": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "reported"
                }
              }
            },
            "then": {
              "properties": {
                "value": {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                },
                "source_id": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "anyOf": [
                {
                  "properties": {
                    "page": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                {
                  "properties": {
                    "section": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              ]
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "ai_inference"
                }
              }
            },
            "then": {
              "properties": {
                "note": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        ]
      }
    },
    "verification": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "pending",
            "checked",
            "disputed"
          ]
        },
        "reviewer": {
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "status",
        "reviewer",
        "note"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "checked"
              }
            }
          },
          "then": {
            "properties": {
              "reviewer": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    }
  },
  "required": [
    "id",
    "source",
    "fields",
    "verification"
  ]
}
