{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^WF-[0-9]{2}$"
    },
    "version": {
      "const": "2.0.0"
    },
    "name_en": {
      "type": "string",
      "minLength": 1
    },
    "name_fa": {
      "type": "string",
      "minLength": 1
    },
    "languages": {
      "const": [
        "en",
        "fa"
      ]
    },
    "updated": {
      "type": "string",
      "format": "date"
    },
    "files": {
      "type": "object",
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "fa": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "en",
        "fa"
      ],
      "additionalProperties": false
    },
    "prompt_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^RP-[0-9]{2}$"
      }
    }
  },
  "required": [
    "id",
    "version",
    "name_en",
    "name_fa",
    "languages",
    "updated",
    "files",
    "prompt_ids"
  ]
}
